<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>surface_gui</name>
  <version>0.1.0</version>
  <description>Rviz 2 panel that drives the surface pipeline: acquisition and reconstruction (surface_reconstruction), raster path (surface_raster_planner), joint path (surface_path_planning), time parametrization and execution. Developed by CARI-JRL.</description>
  <maintainer email="manuel.beschi@unibs.it">Manuel Beschi (CARI-JRL)</maintainer>
  <author email="manuel.beschi@unibs.it">Manuel Beschi</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>qtbase5-dev</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>surface_reconstruction_msgs</depend>
  <depend>surface_raster_planner_msgs</depend>
  <depend>surface_path_planning_msgs</depend>
  <depend>scene_tools_interfaces</depend>


  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
